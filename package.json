  "version": "0.54.0",
  "description": "Multi-agent coordination for AI coding agents - Claude Code, Cursor, and Codex.",
  "license": "MIT",
  "author": "Ryan Kelly",
  "homepage": "https://harnery.com",
  "repository": {
    "type": "git",
